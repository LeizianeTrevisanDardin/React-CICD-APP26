{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "MyNewReactApp-TaskDefinition-Prod",
    "containerDefinitions": [
        {
            "name": "myNewReactApp",
            "image": "935140613475.dkr.ecr.us-east-2.amazonaws.com/my_image:latest",
            "portMappings": [
                {
                    "name": "ngnix-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::935140613475:role/ecsTaskExecutionRole"
}